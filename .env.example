# Copy this file to .env and fill in your Supabase project credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key


# Optional TURN relay so calls work behind strict NATs/firewalls
# (comma-separate multiple URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
